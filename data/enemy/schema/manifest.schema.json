{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "dataVersion", "revision", "publishedAt", "minimumAppVersion", "dataUrl", "dataBytes", "dataSha256", "shipCount", "aliasCount"],
  "properties": {
    "schemaVersion": {"const": 1},
    "dataVersion": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "publishedAt": {"type": "string", "format": "date-time"},
    "minimumAppVersion": {"type": "string", "minLength": 1},
    "dataUrl": {"type": "string", "format": "uri"},
    "dataBytes": {"type": "integer", "minimum": 1},
    "dataSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "shipCount": {"type": "integer", "minimum": 1},
    "aliasCount": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
